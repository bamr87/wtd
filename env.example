# WTD Configuration Example
# Copy this file to .env and customize. Secrets belong here (or in your
# shell env / CI secrets) — never in wtd.yml, which is committable.

# =============================================================================
# LLM Providers — Claude-first
# =============================================================================

# Provider chain. 'auto' (default) = Claude Code OAuth -> Anthropic API.
# Explicit values disable failover: claude-code, anthropic, ollama, openai.
# WTD_LLM_PROVIDER=auto

# Default model (full API ID; the Claude Code lane maps it to a CLI alias).
# WTD_MODEL=claude-opus-5

# --- Lane 1 (default): Claude Code OAuth (subscription) ---
# Mint with: claude setup-token   (or rely on an interactive `claude` login)
# CLAUDE_CODE_OAUTH_TOKEN=
# WTD_CLAUDE_CLI_PATH=claude

# --- Lane 2 (fallback): Anthropic API (metered) ---
# ANTHROPIC_API_KEY=
# Server-side refusal fallbacks on Opus 5 / Fable 5 requests (default on):
# WTD_ANTHROPIC_REFUSAL_FALLBACKS=true

# --- Legacy providers (explicit opt-in only; not part of 'auto') ---
# WTD_OLLAMA_MODEL=llama3.2
# WTD_OLLAMA_HOST=http://localhost:11434
# WTD_OPENAI_API_KEY=
# WTD_OPENAI_MODEL=gpt-4-turbo-preview

# =============================================================================
# GitHub — fleet discovery + (apply mode) writes
# =============================================================================

# Fine-grained PAT or classic token. Read scope is enough for dry-run;
# apply mode needs issues/PR/content write on the roster repos.
# GITHUB_TOKEN=
# WTD_GITHUB_API_URL=https://api.github.com

# =============================================================================
# Fleet orchestration
# =============================================================================

# Master kill switch for the fleet subsystem.
# WTD_FLEET_ENABLED=true

# THE write gate. false (default) = dry-run: agents think, plan, and record,
# but nothing is posted to GitHub. Set true (or pass --apply) to act.
# WTD_FLEET_APPLY=false

# Roster for one-off runs (prefer wtd.yml for anything durable).
# WTD_FLEET_REPOS=owner/repo-one,owner/repo-two

# Path to wtd.yml (default search: ./wtd.yml then ~/.wtd/wtd.yml)
# WTD_FLEET_CONFIG=

# Loop cadence + concurrency + per-cycle caps
# WTD_FLEET_INTERVAL_SECONDS=900
# WTD_FLEET_CONCURRENCY=2
# WTD_FLEET_MAX_RUNS_PER_CYCLE=8
# WTD_FLEET_MAX_WRITES_PER_CYCLE=5

# Daily token budgets per provider lane (the load balancer's capacity)
# WTD_FLEET_CLAUDE_CODE_DAILY_TOKENS=1500000
# WTD_FLEET_ANTHROPIC_DAILY_TOKENS=500000
# WTD_FLEET_ANTHROPIC_DAILY_USD=10.0

# Marker embedded in everything the fleet writes (dedup + loop guards)
# WTD_BOT_MARKER=wtd-fleet

# =============================================================================
# Recursion Settings (local TODO tree)
# =============================================================================

# Maximum depth for recursive TODO spawning (1-10)
WTD_MAX_RECURSION_DEPTH=7

# Fitness decay rate per depth level (0.0-1.0)
# Higher = faster decay = fewer deep subtasks
WTD_FITNESS_DECAY_RATE=0.15

# =============================================================================
# Execution Settings
# =============================================================================

# Auto-execute tasks without confirmation
WTD_AUTO_EXECUTE=false

# Timeout for first action in seconds (KFI target: 90s)
WTD_TIMEOUT_SECONDS=90

# Timeout for a single LLM call (either lane)
# WTD_LLM_TIMEOUT_SECONDS=600

# =============================================================================
# Storage Settings
# =============================================================================

# SQLite database path (default: ~/.wtd/wtd.db)
# WTD_DB_PATH=~/.wtd/wtd.db

# Configuration directory (default: ~/.wtd)
# WTD_CONFIG_DIR=~/.wtd

# Fleet state directory: queue, run ledger, capacity (default: <config_dir>/fleet)
# WTD_FLEET_STATE_DIR=

# =============================================================================
# UI Settings
# =============================================================================

# Theme: dark, light, or auto
WTD_THEME=dark

# Show timestamps in output
WTD_SHOW_TIMESTAMPS=true
